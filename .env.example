# ==============================================================================
# TaskHub Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="TaskHub API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Configuration
# Note: SECRET_KEY must have at least 32 characters for security compliance
SECRET_KEY="taskhub-insecure-default-change-me-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Session 2 Preparation)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/taskhub_dev"
DB_ECHO=false

# Redis Configuration (Future Sessions)
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

